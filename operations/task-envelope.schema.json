{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "XYN Domain Task Envelope v2.0",
  "type": "object",
  "required": [
    "task_id",
    "controller",
    "owner_request",
    "lead",
    "runtime",
    "execution",
    "objective",
    "acceptance_criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "controller": {
      "const": "xyn-01-xyn"
    },
    "owner_request": {
      "type": "string"
    },
    "lead": {
      "type": "string",
      "pattern": "^xyn-(0[2-9]|1[0-9]|2[01])-[a-z]+$"
    },
    "support": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qa": {
      "const": "xyn-13-test"
    },
    "runtime": {
      "enum": [
        "hermes",
        "agy-cli",
        "antigravity-ide",
        "codex"
      ]
    },
    "execution": {
      "type": "object",
      "required": [
        "mode",
        "scope",
        "status"
      ],
      "properties": {
        "mode": {
          "enum": [
            "NATIVE",
            "DIRECT_PROFILE",
            "ASSISTED",
            "UNAVAILABLE",
            "FAILED",
            "BLOCKED",
            "UNVERIFIED"
          ]
        },
        "scope": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PLANNED",
            "RUNNING",
            "COMPLETED",
            "FAILED",
            "BLOCKED",
            "PARTIAL"
          ]
        },
        "dispatch_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "objective": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
